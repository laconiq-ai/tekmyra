{
  "$defs": {
    "CompressionManifestBlock": {
      "additionalProperties": false,
      "properties": {
        "block_id": {
          "title": "Block Id",
          "type": "string"
        },
        "block_type": {
          "title": "Block Type",
          "type": "string"
        },
        "route_class": {
          "$ref": "#/$defs/RouteClass"
        },
        "confidence_calibrated": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence Calibrated",
          "type": "number"
        },
        "risk_class": {
          "$ref": "#/$defs/RiskClass"
        },
        "output_ref": {
          "title": "Output Ref",
          "type": "string"
        },
        "anchor_ids": {
          "items": {
            "type": "string"
          },
          "title": "Anchor Ids",
          "type": "array"
        },
        "verifier_status": {
          "default": "skipped",
          "enum": [
            "pass",
            "fail",
            "skipped"
          ],
          "title": "Verifier Status",
          "type": "string"
        }
      },
      "required": [
        "block_id",
        "block_type",
        "route_class",
        "confidence_calibrated",
        "risk_class",
        "output_ref"
      ],
      "title": "CompressionManifestBlock",
      "type": "object"
    },
    "FallbackLevel": {
      "enum": [
        "normal_compression",
        "relax_budget",
        "block_only_compression",
        "deterministic_only_compression",
        "bypass_original",
        "reject_or_human_review"
      ],
      "title": "FallbackLevel",
      "type": "string"
    },
    "RiskClass": {
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "title": "RiskClass",
      "type": "string"
    },
    "RouteClass": {
      "enum": [
        "passthrough",
        "deterministic_json_compressor",
        "code_compressor",
        "log_compressor",
        "diff_compressor",
        "prose_token_compressor",
        "summarizer",
        "extractive_keypoint_compressor",
        "ocr_first",
        "image_optimizer",
        "chart_table_extraction",
        "pii_redaction_before_compression",
        "governance_safe_compression",
        "legal_security_safe_mode",
        "reversible_retrieval_mode",
        "reject_or_human_review"
      ],
      "title": "RouteClass",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "artifact_id": {
      "title": "Artifact Id",
      "type": "string"
    },
    "is_mixed": {
      "title": "Is Mixed",
      "type": "boolean"
    },
    "blocks": {
      "items": {
        "$ref": "#/$defs/CompressionManifestBlock"
      },
      "title": "Blocks",
      "type": "array"
    },
    "assembly_order": {
      "items": {
        "type": "string"
      },
      "title": "Assembly Order",
      "type": "array"
    },
    "global_fallback": {
      "$ref": "#/$defs/FallbackLevel"
    }
  },
  "required": [
    "artifact_id",
    "is_mixed",
    "blocks",
    "assembly_order",
    "global_fallback"
  ],
  "title": "CompressionManifest",
  "type": "object"
}
