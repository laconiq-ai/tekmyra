{
  "$defs": {
    "PolicyTier": {
      "enum": [
        "standard",
        "regulated",
        "critical"
      ],
      "title": "PolicyTier",
      "type": "string"
    },
    "RiskClass": {
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "title": "RiskClass",
      "type": "string"
    },
    "RouteClass": {
      "enum": [
        "passthrough",
        "deterministic_json_compressor",
        "code_compressor",
        "log_compressor",
        "diff_compressor",
        "prose_token_compressor",
        "summarizer",
        "extractive_keypoint_compressor",
        "ocr_first",
        "image_optimizer",
        "chart_table_extraction",
        "pii_redaction_before_compression",
        "governance_safe_compression",
        "legal_security_safe_mode",
        "reversible_retrieval_mode",
        "reject_or_human_review"
      ],
      "title": "RouteClass",
      "type": "string"
    },
    "SourceChannel": {
      "enum": [
        "api",
        "chat",
        "email",
        "ticket",
        "upload",
        "agent",
        "batch"
      ],
      "title": "SourceChannel",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "decision_id": {
      "title": "Decision Id",
      "type": "string"
    },
    "timestamp": {
      "format": "date-time",
      "title": "Timestamp",
      "type": "string"
    },
    "tenant_id": {
      "title": "Tenant Id",
      "type": "string"
    },
    "artifact_id": {
      "title": "Artifact Id",
      "type": "string"
    },
    "payload_sha256": {
      "title": "Payload Sha256",
      "type": "string"
    },
    "source_channel": {
      "$ref": "#/$defs/SourceChannel"
    },
    "mime_type": {
      "title": "Mime Type",
      "type": "string"
    },
    "policy_tier": {
      "$ref": "#/$defs/PolicyTier"
    },
    "modality_summary": {
      "default": "",
      "title": "Modality Summary",
      "type": "string"
    },
    "parser_outcomes": {
      "additionalProperties": true,
      "title": "Parser Outcomes",
      "type": "object"
    },
    "feature_schema_version": {
      "title": "Feature Schema Version",
      "type": "string"
    },
    "feature_checksum": {
      "title": "Feature Checksum",
      "type": "string"
    },
    "rules_fired": {
      "items": {
        "type": "string"
      },
      "title": "Rules Fired",
      "type": "array"
    },
    "route_before_override": {
      "$ref": "#/$defs/RouteClass"
    },
    "route_after_override": {
      "$ref": "#/$defs/RouteClass"
    },
    "confidence_calibrated": {
      "maximum": 1,
      "minimum": 0,
      "title": "Confidence Calibrated",
      "type": "number"
    },
    "risk_class": {
      "$ref": "#/$defs/RiskClass"
    },
    "risk_score": {
      "maximum": 1,
      "minimum": 0,
      "title": "Risk Score",
      "type": "number"
    },
    "abstained": {
      "title": "Abstained",
      "type": "boolean"
    },
    "latency_ms": {
      "minimum": 0,
      "title": "Latency Ms",
      "type": "number"
    },
    "verifier_result": {
      "enum": [
        "pass",
        "fail",
        "skipped"
      ],
      "title": "Verifier Result",
      "type": "string"
    },
    "reviewer_result": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reviewer Result"
    },
    "block_subroutes": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Block Subroutes",
      "type": "array"
    },
    "versions": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Versions",
      "type": "object"
    }
  },
  "required": [
    "decision_id",
    "timestamp",
    "tenant_id",
    "artifact_id",
    "payload_sha256",
    "source_channel",
    "mime_type",
    "policy_tier",
    "feature_schema_version",
    "feature_checksum",
    "route_before_override",
    "route_after_override",
    "confidence_calibrated",
    "risk_class",
    "risk_score",
    "abstained",
    "latency_ms",
    "verifier_result"
  ],
  "title": "TelemetryRecord",
  "type": "object"
}
