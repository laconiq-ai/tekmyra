            "paid_campaign_authorization_id": {"type": "string", "minLength": 8},
            "paid_campaign_id": {"type": "string", "minLength": 8},
            "paid_campaign_cohort_id": {"type": "string", "minLength": 8},
            "paid_campaign_identity_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "authorized_cap_usd": {"type": "number", "exclusiveMinimum": 0, "maximum": 2},
            "spend_usd": {"type": "number", "minimum": 0},
            "eligible_fixture_count": {"type": "integer", "minimum": 0},
            "evaluated_fixture_count": {"type": "integer", "minimum": 0},
            "report_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "generated_at": {"type": "string"},
            "eligibility_artifact": {"$ref": "#/$defs/artifact_locator"},
            "evaluation_artifact": {"$ref": "#/$defs/artifact_locator"},
            "provider_response_artifact": {"$ref": "#/$defs/artifact_locator"},
            "cost_artifact": {"$ref": "#/$defs/artifact_locator"},
            "no_eligible_reason": {"type": "string"},
            "eligibility_report_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          }
