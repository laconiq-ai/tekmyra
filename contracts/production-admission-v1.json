            "paid_campaign_id": {"type": "string", "minLength": 8},
            "paid_campaign_cohort_id": {"type": "string", "minLength": 8},
            "paid_campaign_identity_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
