            "eligibility_artifact": {"$ref": "#/$defs/artifact_locator"},
            "evaluation_artifact": {"$ref": "#/$defs/artifact_locator"},
            "provider_response_artifact": {"$ref": "#/$defs/artifact_locator"},
            "cost_artifact": {"$ref": "#/$defs/artifact_locator"},
