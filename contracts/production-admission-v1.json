{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://laconiq.com/contracts/tekmyra/production-admission-v1.json",
  "title": "TekMyra customer-production admission evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "release",
    "model_quality",
    "provider_audit",
    "gateway",
    "runtime_image_binding",
    "topology",
    "capacity",
    "operations",
    "canary",
    "rights"
