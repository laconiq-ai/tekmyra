      "properties": {
        "evidence_path": {"type": "string", "minLength": 1},
        "evidence_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "evidence_signature_path": {"type": "string", "minLength": 1}
      }
    },
    "artifact_locator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "signature_path"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "signature_path": {"type": "string", "minLength": 1}
      }
    },
    "file_locator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  },
