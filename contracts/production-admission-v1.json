        "image_reference": {"type": "string", "pattern": "^[^\\s@:]+(/[^\\s@:]+)+@sha256:[0-9a-f]{64}$"},
        "rollback_image_reference": {"type": "string", "pattern": "^[^\\s@:]+(/[^\\s@:]+)+@sha256:[0-9a-f]{64}$"},
