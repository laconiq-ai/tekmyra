            "image_reference": {"type": "string"},
            "fixture_corpus_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "eligibility_set_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "decision": {"enum": ["GO", "NO-GO"]},
