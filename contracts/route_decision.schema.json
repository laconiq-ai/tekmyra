{
  "$defs": {
    "RiskClass": {
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "title": "RiskClass",
      "type": "string"
    },
    "RouteClass": {
      "enum": [
        "passthrough",
        "deterministic_json_compressor",
        "code_compressor",
        "log_compressor",
        "diff_compressor",
        "prose_token_compressor",
        "summarizer",
        "extractive_keypoint_compressor",
        "ocr_first",
        "image_optimizer",
        "chart_table_extraction",
        "pii_redaction_before_compression",
        "governance_safe_compression",
        "legal_security_safe_mode",
        "reversible_retrieval_mode",
        "reject_or_human_review"
      ],
      "title": "RouteClass",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "decision_id": {
      "minLength": 1,
      "title": "Decision Id",
      "type": "string"
    },
    "artifact_id": {
      "minLength": 1,
      "title": "Artifact Id",
      "type": "string"
    },
    "route_before_override": {
      "$ref": "#/$defs/RouteClass"
    },
    "route_after_override": {
      "$ref": "#/$defs/RouteClass"
    },
    "risk_class": {
      "$ref": "#/$defs/RiskClass"
    },
    "risk_score": {
      "maximum": 1,
      "minimum": 0,
      "title": "Risk Score",
      "type": "number"
    },
    "confidence_calibrated": {
      "maximum": 1,
      "minimum": 0,
      "title": "Confidence Calibrated",
      "type": "number"
    },
    "abstained": {
      "default": false,
      "title": "Abstained",
      "type": "boolean"
    },
    "fallback_route": {
      "anyOf": [
        {
          "$ref": "#/$defs/RouteClass"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "rules_fired": {
      "items": {
        "type": "string"
      },
      "title": "Rules Fired",
      "type": "array"
    },
    "explanation_tags": {
      "items": {
        "type": "string"
      },
      "title": "Explanation Tags",
      "type": "array"
    },
    "model_top_k": {
      "items": {
        "maxItems": 2,
        "minItems": 2,
        "prefixItems": [
          {
            "$ref": "#/$defs/RouteClass"
          },
          {
            "type": "number"
          }
        ],
        "type": "array"
      },
      "title": "Model Top K",
      "type": "array"
    },
    "verifier_status": {
      "default": "skipped",
      "enum": [
        "pass",
        "fail",
        "skipped"
      ],
      "title": "Verifier Status",
      "type": "string"
    },
    "mixed_subroutes": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Mixed Subroutes",
      "type": "array"
    },
    "versions": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Versions",
      "type": "object"
    }
  },
  "required": [
    "decision_id",
    "artifact_id",
    "route_before_override",
    "route_after_override",
    "risk_class",
    "risk_score",
    "confidence_calibrated"
  ],
  "title": "RouteDecision",
  "type": "object"
}
